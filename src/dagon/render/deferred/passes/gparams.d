module dagon.render.deferred.passes.gparams;

// Universal enums and bit masks used to pass geometry properties to shaders in the deferred pipeline

/// Meaning of indices in ubo.brdf vector.
enum GeomBRDF: uint
{
    /// Material roughness.
    Roughness = 0,
    
    /// Material metallic.
    Metallic = 1,
    
    /// Base reflectivity, calculated from ior.
    F0 = 2,
    
    /// Material SSS.
    SubsurfaceScattering = 3
}

/// Meaning of indices in ubo.materialOptions vector.
enum GeomMaterialOptions: uint
{
    /// Surface alpha (entity.opacity * material.opacity).
    Alpha = 0,
    
    /// Alpha lower than this value is treated as fully transparent (if alpha clipping is used).
    AlphaClipThreshold = 1,
    
    /// Entity.motionBlurMask.
    MotionBlurMask = 2,
    
    /// Mip level to use for sampling skyboxTexture.
    SkyboxMipLevel = 3
}

/// Meaning of indices in ubo.flags vector.
enum GeomFlags: uint
{
    /// Texture present flags (see GeomTextureFlags).
    Texture = 0,
    
    /// Shader output flags (see GeomOutputFlags).
    Output = 1,
    
    /// Entity flags (see GeomEntityFlags).
    Entity = 2,
    
    /// Pass-specific flags.
    Misc = 3
}

/// Bit masks for GeomFlags.Texture flag.
enum GeomTextureFlags: uint
{
    HasBaseColorTexture = 1 << 0,
    HasNormalTexture = 1 << 1,
    HasHeightTexture = 1 << 2,
    HasRoughnessMetallicTexture = 1 << 3,
    HasEmissionTexture = 1 << 4,
    HasSkyboxTexture = 1 << 5,
    HasAmbientTexture = 1 << 6
}

/// Bit masks for GeomFlags.Output flag.
enum GeomOutputFlags: uint
{
    /// Write Z value to the depth buffer.
    Depth = 1 << 0
}

/// Bit masks for GeomFlags.Entity flag.
enum GeomEntityFlags: uint
{
    ///
    Static = 1 << 0,
    
    ///
    Shaded = 1 << 1
}
