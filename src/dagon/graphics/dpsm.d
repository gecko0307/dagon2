module dagon.graphics.dpsm;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.math.vector;
import dlib.math.matrix;
import dlib.math.transformation;
import dlib.math.base;
import dlib.image.color;

import dagon.core.logger;
import dagon.core.sdl3;
import dagon.core.gpu;
import dagon.core.time;
import dagon.graphics.shadowmap;
import dagon.graphics.light;

/**
 * Dual-paraboloid shadow map.
 */
class DualParaboloidShadowMap: ShadowMap
{
    /// GPU object.
    GPU gpu;
    
    /// Layered depth texture for a dual paraboloid.
    SDL_GPUTexture* depthTexture;
    
    /// Depth texture sampler.
    SDL_GPUSampler* depthSampler;
    
    /**
     * Constructs a dual-paraboloid shadow map for the given light.
     *
     * Params:
     *   light = The light source.
     *   owner = Owner object.
     */
    this(GPU gpu, Light light, Owner owner)
    {
        super(owner);
        this.gpu = gpu;
        this.light = light;
        resize(1024);
        
        SDL_GPUSamplerCreateInfo samplerCreateInfo = {
            min_filter: SDL_GPU_FILTER_LINEAR,
            mag_filter: SDL_GPU_FILTER_LINEAR,
            mipmap_mode: SDL_GPU_SAMPLERMIPMAPMODE_LINEAR,
            address_mode_u: SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            address_mode_v: SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            address_mode_w: SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
            mip_lod_bias: 0.0f,
            max_anisotropy: 1.0f,
            min_lod: 0.0f,
            max_lod: 0.0f,
            enable_anisotropy: false,
            enable_compare: true,
            compare_op: SDL_GPU_COMPAREOP_LESS
        };
        depthSampler = SDL_CreateGPUSampler(gpu.device, &samplerCreateInfo);
    }
    
    /// Destructor. Releases all GPU resources.
    ~this()
    {
        releaseBuffers();
        
        if (depthSampler)
            SDL_ReleaseGPUSampler(gpu.device, depthSampler);
    }
    
    /**
     * Resizes the shadow maps and framebuffers.
     *
     * Params:
     *   res = New resolution for each paraboloid side.
     */
    override void resize(uint res)
    {
        this.resolution = res;
        
        releaseBuffers();
        
        SDL_GPUTextureCreateInfo textureCreateInfo = {
            type: SDL_GPU_TEXTURETYPE_2D_ARRAY,
            format: SDL_GPU_TEXTUREFORMAT_D32_FLOAT,
            width: resolution,
            height: resolution,
            layer_count_or_depth: 2,
            num_levels: 1,
            usage: SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET,
            sample_count: SDL_GPU_SAMPLECOUNT_1
        };
        depthTexture = SDL_CreateGPUTexture(gpu.device, &textureCreateInfo);
    }
    
    /// Releases all GPU resources associated with the shadow map.
    void releaseBuffers()
    {
        if (depthTexture)
            SDL_ReleaseGPUTexture(gpu.device, depthTexture);
    }
}
