module dagon.graphics.shader.std140;

import std.meta: allSatisfy;
import std.traits: Fields, ForeachType, isStaticArray, hasUDA;

import dlib.math.vector;
import dlib.math.matrix;

pragma(inline, true)
private size_t roundUp(size_t value, size_t alignment) pure nothrow @safe @nogc
{
    return (value + alignment - 1) / alignment * alignment;
}

/// UDA: the type is guaranteed by the engine to have std140 layout.
struct Std140Guaranteed {}

enum isStd140Guaranteed(T) = is(T == struct) && hasUDA!(T, Std140Guaranteed);

/// GLSL scalars with a 4- or 8-byte representation. (D's `bool` is 1 byte, GLSL's is 4: use `int`.)
enum isStd140Scalar(T) = is(T == float) || is(T == int) || is(T == uint) || is(T == double);

/// A vector is a struct of 2..4 fields of the same scalar type
template isStd140Vector(T)
{
    static if (is(T == Vector!(U, N), U, int N))
        enum isStd140Vector = N >= 2 && N <= 4;
    else static if (isStaticArray!T)
        enum isStd140Vector = isStd140Scalar!(ForeachType!T) && T.length >= 2 && T.length <= 4;
    else
        enum isStd140Vector = false;
}

private template VectorScalar(T)
{
    static if (isStaticArray!T)
        alias VectorScalar = ForeachType!T;
    else static if (is(T == Vector!(U, N), U, int N))
        alias VectorScalar = U;
}

private template VectorLength(T)
{
    static if (isStaticArray!T)
        enum size_t VectorLength = T.length;
    else static if (is(T == Vector!(U, N), U, int N))
        enum size_t VectorLength = N;
}

/// True for Matrix!(U, N) with float/double elements and 2..4 columns (GLSL matN / dmatN).
template isStd140Matrix(T)
{
    static if (is(T == Matrix!(U, N), U, size_t N))
        enum isStd140Matrix = N >= 2 && N <= 4;
    else
        enum isStd140Matrix = false;
}

private alias MatrixScalar(T : Matrix!(U, N), U, size_t N) = U;
private enum  MatrixDim(T : Matrix!(U, N), U, size_t N) = N;

/// Column stride: the column vector's alignment (vec2 = 2N, vec3/vec4 = 4N) rounded up to 16.
private enum size_t matrixStride(T) = roundUp((MatrixDim!T == 2 ? 2 : 4) * MatrixScalar!T.sizeof, 16);

/// True if T is built only from types that exist in std140 (scalars, vectors, arrays, structs).
template isStd140Type(T)
{
    static if (isStd140Scalar!T || isStd140Vector!T || isStd140Matrix!T)
        enum isStd140Type = true;
    else static if (isStaticArray!T)
        enum isStd140Type = isStd140Type!(ForeachType!T);
    else static if (is(T == struct))
        enum isStd140Type = allSatisfy!(.isStd140Type, Fields!T);
    else static if (isStd140Guaranteed!T)
        enum isStd140Type = true;
    else
        enum isStd140Type = false;
}

/// std140 base alignment (rules 1-4, 9).
template std140Alignment(T) if (isStd140Type!T)
{
    static if (isStd140Scalar!T)
        enum size_t std140Alignment = T.sizeof;
    else static if (isStd140Vector!T)
        enum size_t std140Alignment = (VectorLength!T == 2 ? 2 : 4) * VectorScalar!T.sizeof;
    else static if (isStd140Matrix!T)
        enum size_t std140Alignment = matrixStride!T;
    else static if (isStaticArray!T)
        enum size_t std140Alignment = roundUp(std140Alignment!(ForeachType!T), 16);
    else static if (isStd140Guaranteed!T)
        enum size_t std140Alignment = roundUp(T.alignof, 16);
    else
    {
        private size_t structAlign()
        {
            size_t a = 0;
            static foreach (F; Fields!T)
            {
                if (std140Alignment!F > a)
                    a = std140Alignment!F;
            }
            return roundUp(a, 16);
        }
        enum size_t std140Alignment = structAlign();
    }
}

/// std140 size in bytes, including array stride and struct tail padding.
template std140Size(T) if (isStd140Type!T)
{
    static if (isStd140Scalar!T)
        enum size_t std140Size = T.sizeof;
    else static if (isStd140Vector!T)
        enum size_t std140Size = VectorLength!T * VectorScalar!T.sizeof;
    else static if (isStd140Matrix!T)
        enum size_t std140Size = MatrixDim!T * matrixStride!T;
    else static if (isStaticArray!T)
        enum size_t std140Size = T.length *
            roundUp(std140Size!(ForeachType!T), std140Alignment!T);   // stride * count
    else static if (isStd140Guaranteed!T)
        enum size_t std140Size = T.sizeof;
    else
    {
        private size_t structSize()
        {
            size_t cursor = 0;
            static foreach (F; Fields!T)
                cursor = roundUp(cursor, std140Alignment!F) + std140Size!F;
            return roundUp(cursor, std140Alignment!T);
        }
        enum size_t std140Size = structSize();
    }
}

private bool layoutMatches(T)()
{
    static if (isStd140Scalar!T)
        return T.sizeof == std140Size!T;
    else static if (isStd140Vector!T)
    {
        static if (isStaticArray!T)
            return T.sizeof == std140Size!T;
        else
            return T.sizeof == std140Size!T && T.arrayof.offsetof == 0;
    }
    else static if (isStd140Matrix!T)
        return T.sizeof == std140Size!T && T.arrayof.offsetof == 0;
    else static if (isStaticArray!T)
    {
        alias E = ForeachType!T;
        // D's element stride must equal the std140 stride
        return isStd140Compliant!E
            && E.sizeof == roundUp(std140Size!E, std140Alignment!T);
    }
    else
    {
        size_t cursor = 0;
        bool ok = T.sizeof == std140Size!T;
        static foreach (i, F; Fields!T)
        {{
            cursor = roundUp(cursor, std140Alignment!F);
            ok = ok && isStd140Compliant!F && T.tupleof[i].offsetof == cursor;
            cursor += std140Size!F;
        }}
        return ok;
    }
}

/// Strict check: always verifies the real layout, ignoring the UDA at the top level.
template isStd140Verified(T)
{
    static if (isStd140Guaranteed!T)
        enum isStd140Verified = T.sizeof % 16 == 0 && layoutMatchesFields!T;
    else static if (isStd140Type!T)
        enum isStd140Verified = layoutMatches!T;
    else
        enum isStd140Verified = false;
}

/// The check used by the engine: tagged types pass immediately.
template isStd140Compliant(T)
{
    static if (isStd140Guaranteed!T)
        enum isStd140Compliant = true;
    else
        enum isStd140Compliant = isStd140Verified!T;
}
